<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the report FileProvider may serve (see AndroidManifest.xml). New
     reports live in internal app storage. The external entry only keeps reports
     made by older app versions shareable after an upgrade. Session folders are
     deliberately NOT shareable through this provider. -->
<paths>
    <files-path name="internal_error_reports" path="error_reports/" />
    <external-files-path name="legacy_error_reports" path="error_reports/" />
</paths>
