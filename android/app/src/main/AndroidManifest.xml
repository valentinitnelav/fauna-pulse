<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Internet permission for downloading models -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Round 193 (release plan, Play device eligibility): the back camera IS
         genuinely required (the whole app is a fixed-spot camera trap), so it
         stays required=true (a camera-less device would get a broken install).
         Autofocus hardware is NOT required: the app uses manual focus only
         (round 164), and the focus preset clamps to whatever range the lens
         reports, so fixed-focus devices still work. -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Keep long (hours/days) recording sessions alive: a foreground service with
         an ongoing notification (so the OS won't reclaim the process), a partial
         wake lock, and the notification permission (Android 13+). The app may open
         Android's general battery settings, where the user can choose unrestricted
         operation, but it does not request the policy-sensitive direct-exemption
         permission. The foreground-service type is camera because the protected
         work is the continuous camera session. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- LiteRT declares dataSync for its optional AI Pack downloader. FaunaPulse
         bundles models or imports/downloads ordinary files and never uses AI Packs,
         so remove the unused permission from the merged Play manifest. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />
    <!-- One GPS fix per session (round 126): read once at session setup while
         the app is in the foreground, then the subscription stops. No
         background/continuous tracking, so no FOREGROUND_SERVICE_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:label="FaunaPulse"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Foreground service that keeps a recording session's process alive on
             long field runs (see RecordingService.kt). Not exported; started only
             by this app while recording. -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="camera" />
        <!-- FileProvider: lets MainActivity.sendFileByEmail hand ONE saved error
             report to an email app without exposing the rest of the app's storage.
             The paths it may serve are whitelisted in res/xml/report_file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: lets the About dialog's GitHub link resolve a
             browser (package-visibility rule on Android 11+). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
