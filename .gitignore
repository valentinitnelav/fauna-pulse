# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS is out of scope for this Android-only repository (a separate iOS repo is
# planned). The ios/ folders may exist locally but are never committed here.
**/ios/

# Build artifacts anywhere in the tree (root app + vendored packages/ plugin)
**/build/
**/.dart_tool/
**/.gradle/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/Pods/

# --- Release signing: keystore and credentials are NEVER committed ---
# android/.gitignore already covers these under android/; repeated here so a
# keystore or key.properties dropped anywhere else in the tree stays untracked.
key.properties
*.keystore
*.jks

# --- FaunaPulse: model weights are NEVER committed ---
# Privacy: some detectors belong to collaborators and must not be redistributed via
# this repo. ALL model binaries are git-ignored, everywhere in the tree. Distribute
# models out-of-band (e.g. direct transfer / a shared drive). The in-app model picker
# (lib/fauna_pulse/models/model_catalog.dart) loads whatever .tflite files are present
# locally, so the app still works — a fresh clone simply has no models until you add them.
*.tflite
*.mlpackage
*.mlmodel
*.pt
*.onnx
# Keep the asset folders themselves (so Flutter's declared asset dirs exist on clone):
!assets/models/.gitkeep
!assets/models/custom/.gitkeep

# Per-ABI release APKs staged for GitHub release upload (scripts/build_release_apks.sh)
/dist/
